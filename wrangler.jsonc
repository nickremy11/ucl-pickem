{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ucl-pickem",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true
  },

  // Custom domain on the ffhistorian.com zone. `custom_domain` makes Cloudflare
  // create and manage the DNS record and certificate for this hostname.
  "routes": [
    {
      "pattern": "ucl-pickem.ffhistorian.com",
      "custom_domain": true
    }
  ],

  // `directory` is intentionally omitted: the Cloudflare Vite plugin points it
  // at the client build output automatically.
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ucl-pickem",
      "database_id": "24f1fc53-0ba9-4a03-b762-3195bf521e1b",
      "migrations_dir": "migrations"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "4390887f2ea44689beb3f6f6a13dd842"
    }
  ],

  // Cloudflare Email Sending. A binding, not an API key — there is no secret
  // to rotate or leak. ffhistorian.com is onboarded, so any address on it can
  // be used as the sender.
  "send_email": [{ "name": "EMAIL" }],

  // Two triggers only. `tick` handles lock flips + result polling; `hourly`
  // dispatches the time-gated jobs (odds lock, schedule sync, email, backup)
  // by checking the wall clock in America/New_York, which keeps them correct
  // across DST instead of drifting an hour twice a year.
  "triggers": {
    "crons": ["*/5 * * * *", "0 * * * *"]
  },

  "vars": {
    "COMPETITION_CODE": "CL",
    "COMPETITION_TZ": "America/New_York",
    // Magic links are built from this, so it must be the deployed origin.
    // .dev.vars overrides it with localhost for local development.
    "APP_URL": "https://ucl-pickem.ffhistorian.com",
    "MAIL_FROM_EMAIL": "onboarding@ffhistorian.com",
    "MAIL_FROM_NAME": "UCL Pick'em",
    // "console" prints magic links to the terminal instead of sending them.
    // .dev.vars sets this locally so development never emails real people.
    "MAIL_TRANSPORT": "cloudflare"
  }
}
